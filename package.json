{
  "name": "stata-ide",
  "displayName": "Stata IDE Integration",
  "publisher": "Alec-Doherty",
  "description": "High-performance Stata integration for VS Code",
  "version": "1.0.1",
  "icon": "resources/Stata_logo_med_blue.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "configurationDefaults": {
      "[stata]": {
        "editor.formatOnSave": false
      }
    },
    "languages": [
      {
        "id": "stata",
        "extensions": [
          ".do",
          ".ado"
        ],
        "aliases": [
          "Stata",
          "stata"
        ],
        "configuration": "./stata-language-configuration.json",
        "icon": {
          "light": "./resources/stata-file.svg",
          "dark": "./resources/stata-file.svg"
        }
      },
      {
        "id": "stata-data",
        "extensions": [
          ".dta"
        ],
        "aliases": [
          "Stata Dataset"
        ],
        "icon": {
          "light": "./resources/dta-file.png",
          "dark": "./resources/dta-file.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "stata",
        "scopeName": "source.stata",
        "path": "./syntaxes/stata.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "stata",
        "path": "./snippets/stata.json"
      }
    ],
    "commands": [
      {
        "command": "stata-ide.profileDataset",
        "title": "Stata: Profile Dataset",
        "category": "Stata IDE",
        "icon": "$(dashboard)"
      },
      {
        "command": "stata-ide.executeFile",
        "title": "Run Stata File",
        "icon": "$(play)"
      },
      {
        "command": "stata-ide.stopExecution",
        "title": "Stop Stata Execution",
        "icon": "$(stop)"
      },
      {
        "command": "stata-ide.runBackground",
        "title": "Run in Background",
        "icon": "$(play-circle)"
      },
      {
        "command": "stata-ide.executeCode",
        "title": "Run Selection / Line",
        "icon": "$(selection)"
      },
      {
        "command": "stata-ide.viewActiveDataset",
        "title": "View Active Dataset",
        "icon": "$(table)"
      },
      {
        "command": "stata-ide.showVariables",
        "title": "Show Variables Manager"
      },
      {
        "command": "stata-ide.focusCommandLine",
        "title": "Focus Command Line"
      },
      {
        "command": "stata-ide.history.populate",
        "title": "Populate Command"
      },
      {
        "command": "stata-ide.history.run",
        "title": "Run Command",
        "icon": "$(play)"
      },
      {
        "command": "stata-ide.browseSelected",
        "title": "Browse Selected Variables",
        "icon": "$(table)"
      },
      {
        "command": "stata-ide.variables.filter",
        "title": "Focus Filter",
        "icon": "$(filter)"
      },
      {
        "command": "stata-ide.variables.selectAll",
        "title": "Select All Variables",
        "icon": "$(check-all)"
      },
      {
        "command": "stata-ide.variables.unselectAll",
        "title": "Unselect All Variables",
        "icon": "$(clear-all)"
      },
      {
        "command": "stata-ide.generateCodebook",
        "title": "Generate Codebook",
        "icon": "$(book)"
      },
      {
        "command": "stata-ide.results.insert",
        "title": "Insert Stored Result"
      },
      {
        "command": "stata-ide.clearResults",
        "title": "Clear Results",
        "icon": "$(clear-all)"
      },
      {
        "command": "stata-ide.clearRowFilter",
        "title": "Clear Active Row Filter",
        "icon": "$(clear-all)"
      }
    ],
    "keybindings": [
      {
        "command": "stata-ide.executeCode",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "editorLangId == stata"
      },
      {
        "command": "stata-ide.executeFile",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "editorLangId == stata"
      },
      {
        "command": "stata-ide.viewActiveDataset",
        "key": "ctrl+8",
        "mac": "cmd+8",
        "when": "editorLangId == stata"
      },
      {
        "command": "stata-ide.showVariables",
        "key": "ctrl+4",
        "mac": "cmd+4",
        "when": "editorLangId == stata"
      },
      {
        "command": "stata-ide.focusCommandLine",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "editorLangId == stata"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "stata-ide.executeFile",
          "when": "resourceExtname == .do",
          "group": "navigation@1"
        },
        {
          "command": "stata-ide.executeCode",
          "when": "resourceExtname == .do",
          "group": "navigation@2"
        },
        {
          "command": "stata-ide.runBackground",
          "when": "resourceExtname == .do",
          "group": "navigation@4"
        },
        {
          "command": "stata-ide.stopExecution",
          "when": "resourceLangId == stata",
          "group": "navigation@3"
        },
        {
          "command": "stata-ide.viewActiveDataset",
          "when": "resourceExtname == .do",
          "group": "navigation@5"
        },
        {
          "command": "stata-ide.profileDataset",
          "when": "resourceLangId == stata",
          "group": "navigation@6"
        }
      ],
      "view/title": [
        {
          "command": "stata-ide.browseSelected",
          "when": "view == stata-ide-variables-view",
          "group": "navigation@1"
        },
        {
          "command": "stata-ide.generateCodebook",
          "when": "view == stata-ide-variables-view",
          "group": "navigation@2"
        },
        {
          "command": "stata-ide.variables.filter",
          "when": "view == stata-ide-variables-view",
          "group": "navigation@3"
        },
        {
          "command": "stata-ide.variables.selectAll",
          "when": "view == stata-ide-variables-view",
          "group": "navigation@4"
        },
        {
          "command": "stata-ide.variables.unselectAll",
          "when": "view == stata-ide-variables-view",
          "group": "navigation@5"
        },
        {
          "command": "stata-ide.clearResults",
          "when": "view == stataResultsView",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Stata IDE",
      "properties": {
        "stata-ide.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to Python executable."
        },
        "stata-ide.stataPath": {
          "type": "string",
          "default": "",
          "description": "Path to Stata directory."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "stata-ide.dtaViewer",
        "displayName": "Stata Dataset Viewer",
        "selector": [
          {
            "filenamePattern": "*.dta"
          }
        ]
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "stata-ide-bottom",
          "title": "Stata",
          "icon": "$(server-environment)"
        }
      ]
    },
    "views": {
      "stata-ide-bottom": [
        {
          "id": "stata-ide-history-view",
          "name": "History",
          "icon": "$(history)"
        },
        {
          "type": "webview",
          "id": "stataResultsView",
          "name": "Stata Results",
          "icon": "$(terminal)"
        },
        {
          "type": "webview",
          "id": "stata-ide-variables-view",
          "name": "Variables in Memory",
          "icon": "$(list-flat)"
        },
        {
          "id": "stata-ide-stored-results-view",
          "name": "Stored Results",
          "icon": "$(archive)"
        }
      ]
    }
  }
}