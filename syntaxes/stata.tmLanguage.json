{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Stata",
    "scopeName": "source.stata",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#macros"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "match": "^\\s*\\*.*$",
                    "name": "comment.line.star.stata"
                },
                {
                    "match": "//.*$",
                    "name": "comment.line.double-slash.stata"
                },
                {
                    "match": "///.*$",
                    "name": "comment.line.continuation.stata"
                },
                {
                    "begin": "/\\*",
                    "end": "\\*/",
                    "name": "comment.block.stata"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "begin": "\"",
                    "end": "\"",
                    "name": "string.quoted.double.stata",
                    "patterns": [
                        {
                            "include": "#macros"
                        }
                    ]
                },
                {
                    "begin": "`\"",
                    "end": "\"'",
                    "name": "string.quoted.compound.stata",
                    "patterns": [
                        {
                            "include": "#macros"
                        }
                    ]
                }
            ]
        },
        "macros": {
            "patterns": [
                {
                    "match": "`[a-zA-Z_][a-zA-Z0-9_]*'",
                    "name": "variable.language.local.stata"
                },
                {
                    "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*|\\$\\{[a-zA-Z_][a-zA-Z0-9_]*\\}",
                    "name": "variable.language.global.stata"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
                    "name": "entity.name.function.stata"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "match": "\\b(clear|set|run|do|local|global|use|assert|generate|gen|count|display|di|drop|keep|if|in|byte|int|long|float|double|str[0-9]*|replace|rename|sort|merge|append|collapse|preserve|restore|quietly|qui|capture|cap|noisily|noi|summarize|sum|tabulate|tab|regress|reg|more|off|all)\\b",
                    "name": "keyword.control.stata"
                },
                {
                    "match": "\\b(as|text|result|name|title|replace|clear)\\b",
                    "name": "keyword.other.stata"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
                    "name": "constant.numeric.stata"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "match": "==|!=|>=|<=|>|<|!|\\+|-|\\*|/|=|\\|\\||&&|&|\\|",
                    "name": "keyword.operator.stata"
                }
            ]
        }
    }
}