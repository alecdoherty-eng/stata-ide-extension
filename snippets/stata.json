{
    "For Values Loop": {
        "prefix": "forv",
        "body": [
            "forvalues ${1:i} = ${2:1}/${3:10} {",
            "\t$0",
            "}"
        ],
        "description": "Scaffold a Stata forvalues loop"
    },
    "Foreach Loop": {
        "prefix": "fore",
        "body": [
            "foreach ${1:var} of ${2|local,global,varlist|} ${3:list_name} {",
            "\t$0",
            "}"
        ],
        "description": "Scaffold a Stata foreach loop"
    },
    "Merge Datasets": {
        "prefix": "merge",
        "body": [
            "merge ${1|1:1,m:1,1:m,m:m|} ${2:varlist} using \"${3:filename}\", ${4:keep(master match) nokeep}",
            "$0"
        ],
        "description": "Scaffold a Stata merge command"
    },
    "Frame Put": {
        "prefix": "frameput",
        "body": [
            "frame put ${1:varlist}, into(${2:new_frame_name})",
            "frame ${2:new_frame_name} {",
            "\t$0",
            "}"
        ],
        "description": "Copy variables to a new memory frame and switch to it"
    }
}